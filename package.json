{
  "name": "google-health-cli",
  "version": "1.0.0",
  "description": "Unofficial TypeScript CLI for the Google Health API",
  "author": "Google Health CLI Contributors",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ghealth": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outfile dist/index.js --target bun",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "csv-stringify": "^6.5.2",
    "open": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
